# Reference only: .env files are NOT loaded automatically.
# Set process environment variables before starting the app.
# Alternatively, enter the OpenAI key in the HR interface.
# Never commit a real key. Passwords are set interactively, not here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional database path; default is career_quest.sqlite3 in project root.
# CAREER_QUEST_DB=career_quest.sqlite3

# Used only when creating accounts on first startup.
DEMO_EMPLOYEE_ID=E0001
